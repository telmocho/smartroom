<?xml version="1.0" encoding="UTF-8"?>

<?xml-stylesheet href="https://moise-lang.github.io/xml/os.xsl" type="text/xsl" ?>

<organisational-specification
    id="smartroom"
    os-version="0.8"

    xmlns='http://moise.sourceforge.net/os'
    xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
    xsi:schemaLocation='http://moise.sourceforge.net/os
                        https://moise-lang.github.io/xml/os.xsd' >

<structural-specification>

<role-definitions>
    <role id="controller" />
    <role id="assistant" />
</role-definitions>

<group-specification id="room">
    <roles>
        <role id="controller" min="1" max="1"/>
        <role id="assistant" min="1" max="5"/>
    </roles>

    <!--<links>
       <link from="controller" to="assistant" type="authority"     scope="intra-group" bi-dir="false"/>
       <link from="assistant" to="controller" type="communication" scope="intra-group" bi-dir="false"/>
    </links>-->
    <formation-constraints>
       <!-- <compatibility from="controller" to="assistant" /> Esto no tiene sentido porque no se puede ser controller y assistant a la vez -->
    </formation-constraints>
</group-specification>
</structural-specification>

<functional-specification> <!-- Aquí describimos el esquema de funcionamiento de la organización, es decir, los planes y misiones que se pueden ejecutar -->
    <scheme id="decide_temp">
        <goal id="voting">
            <plan operator="sequence">
                <goal id="census" />
                <goal id="open_voting"    ttf="4 seconds" ds="Apertura de la votación"/>
                <goal id="vote" ds="Emitir voto"/>
                <goal id="close_voting" ds="Cerrar la votación"/>
            </plan>
        </goal>

        <mission id="mVoteController" min="1" max="1"> <!-- Misión de controlar la votación, los ids de misiones empiezan por m -->
            <goal id="census"/>
            <goal id="open_voting"/>
            <goal id="close_voting"/>
        </mission>
        <mission id="mVote" min="1" max="5"> <!-- Misión de votar: la deben cumplir entre 1 y 5 agentes -->
            <goal id="vote"/>
        </mission>
    </scheme>
</functional-specification>

<normative-specification>
    <!--
       setup of Moise properties (e.g. role compatibility) handling (regimented or not)

       when value = "fail", the platform ensures that the property is not broken (the property is thus regiment)
       when value = "prohibition", violations are produced when the property is not followed by the agents
       when value = "ignore", no norm is produced 

       possible properties are defined in https://github.com/moise-lang/moise/blob/master/src/main/java/ora4mas/nopl/tools/os2nopl.java

       some examples follow
    -->
    <!-- properties>
        <property id="default_management"  value="fail" />
        <property id="role_compatibility"  value="prohibition" />
        <property id="mission_cardinality" value="prohibition" />
    </properties-->

    <!-- the norms of the application -->
    <!-- Aquí obligo a agentes a cumplir misiones-->
    <norm id="norm1" type="obligation" role="controller" mission="mVoteController"/>
    <norm id="norm2" type="obligation" role="assistant"  mission="mVote"/>
</normative-specification>

</organisational-specification>
