    smartroom
    ---------------------------

    JaCaMo Application File

    This file defines the initial state of the MAS (initial agents, environment, organisation, ....)

    (see jacamo/doc/jcm.html for more information about what can be defined in this file)

    JaCaMo 1.3.0
    septiembre 25, 2026 - 13:55:25
*/

mas smartroom {

    /*agent bob: sample_agent.asl {
      focus: w.c1 
    }*/

    agent mario: personal_assistant.asl {
      beliefs: preference(23)
      focus: vm::w.vm
      // focus: w.vm //antes
    }

    agent luiggi: personal_assistant.asl {
      beliefs: preference(23)
      focus: vm::w.vm
      // focus: w.vm // antes
    }

    agent bowser: personal_assistant.asl {
      beliefs: preference(28)
      focus: vm::w.vm
      // focus: w.vm // antes
    }

    agent rc: room_controller.asl {
      focus: w.hvac
      focus: vm::w.vm
      focus: c1::w.c1
      focus: gui::w.consola
      goals: startVoting([21, 23, 27], 1000)
      // goals: voting([21, 23, 27], 1000) // Se ha quitado para que no de problemas con la antigua forma de votar
    }

    /*agent rc: user_preferenes_agent.asl {
      focus: w.hvac
    }*/

    workspace w {
      artifact c1: example.Counter(3)
      artifact hvac: devices.HVAC(40)
      artifact vm: devices.VotingMachine()
      artifact consola: gui.GUIConsole("Consola de depuración")
    }

    organisation o: org.xml {
      group g1 : group1 {
        players: bob role1
      }
    }

    

}
